{
  "openapi": "3.1.0",
  "info": {
    "title": "API Test Evidence Lab",
    "description": "A local-first, controlled OpenAPI test-generation workspace.",
    "version": "1.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/specifications/parse": {
      "post": {
        "summary": "Parse Specification",
        "operationId": "parse_specification_api_specifications_parse_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/reports": {
      "get": {
        "summary": "Report History",
        "operationId": "report_history_api_reports_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ReportIndexItem"
                  },
                  "type": "array",
                  "title": "Response Report History Api Reports Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/test-cases/generate": {
      "post": {
        "summary": "Generate",
        "operationId": "generate_api_test_cases_generate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/test-runs": {
      "post": {
        "summary": "Run Cases",
        "operationId": "run_cases_api_test_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/reports/{report_id}": {
      "get": {
        "summary": "Get Report",
        "operationId": "get_report_api_reports__report_id__get",
        "parameters": [
          {
            "name": "report_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Report Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CaseCategory": {
        "type": "string",
        "enum": [
          "positive",
          "negative",
          "boundary",
          "authentication"
        ],
        "title": "CaseCategory"
      },
      "ExecutionOutcome": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "actual_status": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actual Status"
          },
          "duration_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Ms"
          },
          "response_summary": {
            "title": "Response Summary"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "ExecutionOutcome"
      },
      "GenerateRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "operation_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Operation Ids"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "operation_ids"
        ],
        "title": "GenerateRequest"
      },
      "GenerateResponse": {
        "properties": {
          "cases": {
            "items": {
              "$ref": "#/components/schemas/TestCase"
            },
            "type": "array",
            "title": "Cases"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "prompt_version": {
            "type": "string",
            "title": "Prompt Version"
          }
        },
        "type": "object",
        "required": [
          "cases",
          "model",
          "prompt_version"
        ],
        "title": "GenerateResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "anthropic_configured": {
            "type": "boolean",
            "title": "Anthropic Configured"
          },
          "allowed_mockoon_origins": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Allowed Mockoon Origins"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "anthropic_configured",
          "allowed_mockoon_origins"
        ],
        "title": "HealthResponse"
      },
      "ReportIndexItem": {
        "properties": {
          "report_id": {
            "type": "string",
            "title": "Report Id"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "specification_title": {
            "type": "string",
            "title": "Specification Title"
          },
          "target": {
            "type": "string",
            "title": "Target"
          },
          "counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Counts"
          }
        },
        "type": "object",
        "required": [
          "report_id",
          "created_at",
          "specification_title",
          "target",
          "counts"
        ],
        "title": "ReportIndexItem"
      },
      "RunRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "target_base_url": {
            "type": "string",
            "title": "Target Base Url"
          },
          "cases": {
            "items": {
              "$ref": "#/components/schemas/TestCase"
            },
            "type": "array",
            "minItems": 1,
            "title": "Cases"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "target_base_url",
          "cases"
        ],
        "title": "RunRequest"
      },
      "RunSummary": {
        "properties": {
          "report_id": {
            "type": "string",
            "title": "Report Id"
          },
          "counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Counts"
          },
          "cases": {
            "items": {
              "$ref": "#/components/schemas/TestCase"
            },
            "type": "array",
            "title": "Cases"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "report_id",
          "counts",
          "cases"
        ],
        "title": "RunSummary"
      },
      "TestCase": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "path": {
            "type": "string",
            "title": "Path"
          },
          "method": {
            "type": "string",
            "title": "Method"
          },
          "category": {
            "$ref": "#/components/schemas/CaseCategory"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "path_params": {
            "additionalProperties": true,
            "type": "object",
            "title": "Path Params"
          },
          "query_params": {
            "additionalProperties": true,
            "type": "object",
            "title": "Query Params"
          },
          "headers": {
            "additionalProperties": true,
            "type": "object",
            "title": "Headers"
          },
          "body": {
            "title": "Body"
          },
          "expected_status": {
            "type": "integer",
            "title": "Expected Status"
          },
          "expected_condition": {
            "type": "string",
            "title": "Expected Condition",
            "default": "Response status matches the expected status code."
          },
          "auth_required": {
            "type": "boolean",
            "title": "Auth Required",
            "default": false
          },
          "validation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ValidationOutcome"
              },
              {
                "type": "null"
              }
            ]
          },
          "execution": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExecutionOutcome"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "path",
          "method",
          "category",
          "description",
          "expected_status"
        ],
        "title": "TestCase"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "ValidationOutcome": {
        "properties": {
          "valid": {
            "type": "boolean",
            "title": "Valid"
          },
          "violations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Violations"
          }
        },
        "type": "object",
        "required": [
          "valid"
        ],
        "title": "ValidationOutcome"
      }
    }
  }
}